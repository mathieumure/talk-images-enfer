# Scaleway Credentials
# Get these from: https://console.scaleway.com/project/credentials

# Access key for Scaleway API
export SCALEWAY_ACCESS_KEY=SCW...

# Secret key for Scaleway API
export SCALEWAY_SECRET_KEY=...

# Organization ID (found in organization settings)
export SCALEWAY_ORGANIZATION_ID=...

# Project ID (found in project settings)
export SCALEWAY_PROJECT_ID=...

# Optional: imgproxy URL signature protection
# Generate with: openssl rand -hex 32
# export IMGPROXY_KEY=...
# export IMGPROXY_SALT=...
