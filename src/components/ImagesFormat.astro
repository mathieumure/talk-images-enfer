---
import Slide from "./Slide.astro";

type ImageFormat = 'jpg' | "bmp" | "png" | "gif" | "webp" | "svg" | "avif" | "jpgxl";

const formats: Array<ImageFormat> = ['jpg' , "bmp" , "png" , "gif" , "webp" , "svg" , "avif" , "jpgxl" ]

type Props = {
	current?: ImageFormat;
	qrCode?: string;
}
---
<Slide data-background-image="https://talk-assets.s3.fr-par.scw.cloud/styx.webp" data-background-size="contain" class="imageSlide" data-qrcode={Astro.props.qrCode}>
	{ formats.map(format => {
		if (format === Astro.props.current) {
			return <div class="container">
				<img src={`https://talk-assets.s3.fr-par.scw.cloud/${format}_logo.png`} />
				<div class="text-content">
					<slot />
				</div>
			</div>
		}
		return <img class={format} src={`https://talk-assets.s3.fr-par.scw.cloud/${format}_logo.png`}/>;
	}) }
</Slide>

<style>
	.imageSlide {
		height: 100%;
		width: 100%;
	}
	.bmp {
		position: absolute;
		top: 47%;
		left: 13%;
		width: 7%;
	}
	.gif {
		position: absolute;
		top: 42%;
		left: 20%;
		width: 7%;
	}
	.svg {
		position: absolute;
		top: 5%;
		left: 70%;
		width: 7%;
	}
	.jpg {
		position: absolute;
		top: 25%;
		left: 40%;
		width: 7%;
	}
	.webp {
		position: absolute;
		top: 30%;
		left: 62%;
		width: 7%;
	}
	.png {
		position: absolute;
		top: 17%;
		left: 47%;
		width: 7%;
	}
	.avif {
		position: absolute;
		top: 22%;
		left: 70%;
		width: 7%;
	}
	.jpgxl {
		position: absolute;
		top: 13%;
		left: 78%;
		width: 7%;
	}

	.container {
		min-height: 50vh;
		position: relative;
		background-color: white;
		z-index: 1000;
		display: grid;
		grid-template-columns: 40% 60%;
		color: black;
		img {
			padding: 15px;
			object-fit: contain;
		}
	}

	.text-content {
		background-color: black;
		color: white;
		flex: 1;
		padding: 15px;
		font-family: "P22Underground", system-ui;
		font-size: 2rem;

		h4 {
			font-family: "Spectral SC", system-ui;
			color: #40bb3f;
			font-size: 4rem;
		}
	}
</style>
