---
import QRCode from './QRCode.astro';

interface Props {
  /**
   * Use the auto-animate feature for this slide or not
   *
   * default: true
   */
  animate?: boolean;
	class?: string;
	qrcode?: string;
}

const { animate = true, qrcode } = Astro.props;
---

<section {...Astro.props} data-auto-animate={animate}>
  <slot />
</section>
{qrcode && <QRCode url={qrcode} />}
