---
import QRCode from "../components/QRCode.astro";
const { title } = Astro.props;
import "@fontsource/caesar-dressing";
import "@fontsource/spectral-sc";
import "@fontsource/lato";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
	</head>

	<body>
		<slot />

		<QRCode />

		<script>
			import Reveal from "reveal.js";
			import QRCodeLib from 'qrcode';
			import RevealHighlight from "reveal.js/plugin/highlight/highlight";

			Reveal.initialize({
				transition: "none",
				history: true,
				// progress: false,
				// controls: false,
				autoAnimateDuration: 0.5,
				autoAnimateEasing: "cubic-bezier(0.4, 0, 0.2, 1)",
				width: "100%",
				height: "100%",
				// margin: 0,
				minScale: 1,
				maxScale: 1,
				// plugins: [RevealHighlight], // use this if you want to show some code (be aware that it's really heavy, see https://x.com/jsulpis/status/1795536457819431408)
			});

			const updateQRCode = async (url: string) => {
				const data = await QRCodeLib.toDataURL(url, {
					errorCorrectionLevel: 'H',
					margin: 1,
					width: 400,
					color: {
						dark: '#e16605',
						light: '#000000'
					}
				});
				const qrcode = document.querySelector('.qrcode') as HTMLImageElement;
				qrcode.src = data;
				(document.querySelector('.qrcode-container') as HTMLDivElement).style.opacity = '1';
			}

			Reveal.on("slidechanged", function (event: any) {
				const currentSlide = event.currentSlide;
				const qrcodeUrl = currentSlide.getAttribute('data-qrcode');
				console.log(qrcodeUrl);
				if (qrcodeUrl) {
					updateQRCode(qrcodeUrl);
				} else {
					(document.querySelector('.qrcode-container') as HTMLDivElement).style.opacity = '0';
				}
			});
		</script>
	</body>
</html>

<style is:global lang="scss">
	// Sass is installed by default, you can change if you prefer Stylus or Less

	@import "reveal.js/dist/reveal.css";
	@import "reveal.js/dist/theme/night.css";
	@import "../../src/styles/highlightjs-theme-vs2015.css";

	@font-face {
		font-family: "P22Underground";
		src: url("/fonts/P22Underground-BkP.woff2") format("woff2");
		font-weight: normal;
		font-style: normal;
		font-display: swap;
	}

	main,
	.slide-background-content {
		background: black;
	}
</style>
