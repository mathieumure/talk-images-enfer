---
import Slide from "../components/Slide.astro";
---

<Slide class="title-slide" data-background-video="https://talk-assets.s3.fr-par.scw.cloud/Talkimages_intro.mp4" data-background-video-loop data-background-video-muted data-background-size="cover">
	<p class="title first">Au secours, mes</p>
	<img src="https://talk-assets.s3.fr-par.scw.cloud/Intro_logo.png" alt="intro" />
	<p class="title second">pourrissent mes perfs</p>
</Slide>

<style lang="scss">
	.title {
		font-family: 'Spectral SC', system-ui;
		text-shadow: 2px 2px 6px #000;
	}

	.title.first {
		font-size: 72px;
	}

	.title.second {
		font-size: 72px;
	}

	img {
		margin: -64px auto -43px;
		flex: 0;
		max-width: 550px;
	}

	.title-slide {
		height: 100%;
		display: flex !important;
		flex-direction: column;
		justify-content: end;
	}
</style>
