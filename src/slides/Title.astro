---
import Slide from "../components/Slide.astro";
---

<Slide>
	<video src="https://talk-assets.s3.fr-par.scw.cloud/Talkimages_intro.mp4" loop muted autoplay class="video" />
	<div class="content">
		<h1>Au secours, mes</h1>
  	<img src="https://talk-assets.s3.fr-par.scw.cloud/Intro_logo.png" alt="intro" />
		<h2>pourrissent mes perfs</h2>
	</div>
</Slide>

<style lang="scss">
	h1, h2 {
		font-family: 'Caesar Dressing', system-ui;
		text-shadow: 2px 2px 6px #000;
	}

	h1 {
		font-size: 72px;
		margin-bottom: -50px;
	}

	h2 {
		font-size: 72px;
		margin-top: -50px;
	}

	.video {
		width: 100%;
		max-width: 100%;
		min-width: 100%;
	}

	.content {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		padding-bottom: 50px;

		img {
			margin: 0;
			flex: 0;
			max-width: 671px;
		}
	}
</style>
