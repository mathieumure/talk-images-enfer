---
import Slide from "../components/Slide.astro";
import ImagesFormat from "../components/ImagesFormat.astro";

---

<Slide>
	<ImagesFormat />
	<ImagesFormat current="bmp">
		<h4>Bitmap</h4>
		<ul>
			<li>Créé en 1986 par Microsoft</li>
			<li>Stocke chaque pixel sans compression en valeurs RGB brutes</li>
		</ul>
	</ImagesFormat>
	<ImagesFormat />
	<ImagesFormat current="gif">
		<h4>Graphics Interchange Format</h4>
		<ul>
			<li>Créé en 1987 par CompuServe</li>
			<li>Utilise une palette de 256 couleurs avec compression LZW</li>
		</ul>
	</ImagesFormat>
	<ImagesFormat />
	<ImagesFormat current="jpg">
		<h4>Joint Photographic Experts Group</h4>
		<ul>
			<li>Créé en 1992 par Joint Photographic Experts Group</li>
			<li>Transformée en cosinus discrète avec compression par blocs 8x8 et quantification</li>
		</ul>
	</ImagesFormat>
	<ImagesFormat />
	<ImagesFormat current="png">
		<h4>Portable Network Graphics</h4>
		<ul>
			<li>Créé en 1996 par Groupe de travail PNG</li>
			<li>Compression DEFLATE sans perte avec filtrage prédictif par lignes</li>
		</ul>
	</ImagesFormat>
	<ImagesFormat />
	<ImagesFormat current="svg">
		<h4>Scalable Vector Graphics</h4>
		<ul>
			<li>Créé en 2001 par W3C</li>
			<li>Décrit les formes géométriques en langage XML avec coordonnées mathématiques</li>
		</ul>
	</ImagesFormat>
	<ImagesFormat />
	<ImagesFormat current="webp">
		<h4>Webp</h4>
		<ul>
			<li>Créé en 2010 par Google</li>
			<li>Basé sur le Codev vidéo VP8</li>
		</ul>
	</ImagesFormat>
	<ImagesFormat />
	<ImagesFormat current="avif">
		<h4>AVIF</h4>
		<ul>
			<li>Créé en 2019 par Alliance for Open Media</li>
			<li>Basé sur le Codev vidéo AV1</li>
		</ul>
	</ImagesFormat>
	<ImagesFormat />
	<ImagesFormat current="jpgxl">
		<h4>JPEG XL</h4>
		<ul>
			<li>Créé en 2021 par Joint Photographic Experts Group</li>
			<li>Combine compression avec et sans perte via modulation VarDCT et transformées adaptatives avec prédiction contextuelle</li>
		</ul>
	</ImagesFormat>
</Slide>

<style lang="scss" is:global>
	.imageSlide {
		height: 100%;
		width: 100%;
	}
	.bmp {
		position: absolute;
		top: 47%;
		left: 13%;
		width: 7%;
	}
	.gif {
		position: absolute;
		top: 42%;
		left: 20%;
		width: 7%;
	}
	.svg {
		position: absolute;
		top: 5%;
		left: 70%;
		width: 7%;
	}
	.jpg {
		position: absolute;
		top: 25%;
		left: 40%;
		width: 7%;
	}
	.webp {
		position: absolute;
		top: 30%;
		left: 62%;
		width: 7%;
	}
	.png {
		position: absolute;
		top: 17%;
		left: 47%;
		width: 7%;
	}
	.avif {
		position: absolute;
		top: 22%;
		left: 70%;
		width: 7%;
	}
	.jpgxl {
		position: absolute;
		top: 13%;
		left: 78%;
		width: 7%;
	}

	.container {
		position: relative;
		background-color: white;
		z-index: 1000;
		display: flex;
		margin: auto;
		color: black;
		img {
			width: 40%;
		}
		h4 {
			color: black;
		}
	}
</style>
