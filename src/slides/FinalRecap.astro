---
import BoonContent from "../components/BoonContent.astro";
import BoonSlide from "../components/BoonSlide.astro";
---
<BoonSlide>
	<BoonContent title="Le web c'est les images" icon="https://talk-assets.s3.fr-par.scw.cloud/boons/Hera_images.png">
		Ou est-ce que ce ne serait pas l'inverse ?
	</BoonContent>
	<BoonContent title="Le format c'est la vie" icon="https://talk-assets.s3.fr-par.scw.cloud/boons/Hera_love.png">
		Le bon format, la bonne taille et dans la bonne page !
	</BoonContent>
	<BoonContent title="L'enfer c'est les autres" icon="https://talk-assets.s3.fr-par.scw.cloud/boons/Hera_hand.png">
		La gestion des images c'est le nerf de la guerre
	</BoonContent>
	<BoonContent title="Cloud ou pas cloud" icon="https://talk-assets.s3.fr-par.scw.cloud/boons/Hera_glyphe.png">
		Store, transform & cache est un pattern qui peut être mis en place... vous n'avez plus d'excuse.
	</BoonContent>
</BoonSlide>
