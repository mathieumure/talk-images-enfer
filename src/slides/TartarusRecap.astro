---
import BoonSlide from "../components/BoonSlide.astro";
import BoonContent from "../components/BoonContent.astro";
---
<BoonSlide>
	<BoonContent title="srcset" icon="https://talk-assets.s3.fr-par.scw.cloud/boons/SupportFire.png">
		Toujours définir des tailles adaptés à la largeur et la densité de votre écran.
	</BoonContent>
	<BoonContent title="sizes" icon="https://talk-assets.s3.fr-par.scw.cloud/boons/Sizes.png">
		En complément de srcset pour avoir l'image adapté au rendu
	</BoonContent>
	<BoonContent title="lazy" icon="https://talk-assets.s3.fr-par.scw.cloud/boons/Lazy.png">
		Lazyloader au maximum les images en dehors du viewport
	</BoonContent>
	<BoonContent title="progressive" icon="https://talk-assets.s3.fr-par.scw.cloud/boons/Deer.png">
		Implémenter le pattern de rendu progressive pour réduire au maximum votre CLS
	</BoonContent>
</BoonSlide>
