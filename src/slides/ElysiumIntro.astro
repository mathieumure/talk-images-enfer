---

import Slide from "../components/Slide.astro";
import TextBox from "../components/TextBox.astro";
import StorySlide from "../components/StorySlide.astro";

const introText = [
	'Vous voilà maintenant coincé dans Elysium.',
	'Comme beaucoup d\'autres avant vous, vous errez maintenant sans but,',
	'mais peut être que ce paradis n\'est qu\'une chimère.',
	'Il ne vous reste plus qu\'à vous assoir et scroller de vidéo en vidéo...'
]

const code = `<picture>
  <source type="image/webp" src-set="
  	https://localhell:666/img/heracles.tiff?f=webp&q=75&w=640 640w,
  	https://localhell:666/img/heracles.tiff?f=webp&q=75&w=1024 1024w,
  	https://localhell:666/img/heracles.tiff?f=webp&q=75&w=2048 2048w,
  	https://localhell:666/img/heracles.tiff?f=webp&q=75&w=4096 4096w,
  "/>
  <source type="image/avif" src-set="
  	https://localhell:666/img/heracles.tiff?f=avif&q=75&w=640 640w,
  	https://localhell:666/img/heracles.tiff?f=avif&q=75&w=1024 1024w,
  	https://localhell:666/img/heracles.tiff?f=avif&q=75&w=2048 2048w,
  	https://localhell:666/img/heracles.tiff?f=avif&q=75&w=4096 4096w,
  "/>
</picture>`
---

<Slide>
	<StorySlide text={introText}/>
	<Slide data-background-image="https://talk-assets.s3.fr-par.scw.cloud/elysium_0.jpg">
		<h1 class="fragment">Un ares et ça repart...</h1>
	</Slide>
	<Slide data-background-image="https://talk-assets.s3.fr-par.scw.cloud/elysium_1.jpg">
		<img src="https://talk-assets.s3.fr-par.scw.cloud/prometeus.png" style="width: 50%" class="fragment">
	</Slide>
	<Slide data-background-image="https://talk-assets.s3.fr-par.scw.cloud/elysium_1.jpg">
		<div class="sideToSide">
			<img src="https://talk-assets.s3.fr-par.scw.cloud/prometeus.png" style="width: 50%">
			<div class="sideText">
				<ul>
						<li class="fragment">Stocker l'essence</li>
						<li class="fragment">Bucket S3</li>
						<li class="fragment">Accessible en HTTP</li>
				</ul>
			</div>
		</div>
	</Slide>
	<Slide data-background-image="https://talk-assets.s3.fr-par.scw.cloud/elysium_2.webp">
		<img src="https://talk-assets.s3.fr-par.scw.cloud/cerberus.png" style="width: 50%" class="fragment">
	</Slide>
	<Slide data-background-image="https://talk-assets.s3.fr-par.scw.cloud/elysium_2.webp">
		<div class="sideToSide">
			<img src="https://talk-assets.s3.fr-par.scw.cloud/cerberus.png" style="width: 50%">
			<div class="sideText">
				<ul>
					<li class="fragment">Transformer au bon format</li>
					<li class="fragment">A la volée</li>
					<li class="fragment">via des paramètres d'URL</li>
					<pre class="fragment local-code language-bash"><code>https://img.localhell:666/essence.tiff?
						f=webp&
						w=1080&
						q=75</code></pre>
				</ul>
			</div>
		</div>
	</Slide>
	<Slide data-background-image="https://talk-assets.s3.fr-par.scw.cloud/elysium_2.webp">
		<div class="sideToSide">
			<img src="https://talk-assets.s3.fr-par.scw.cloud/cerberus.png" style="width: 30%">
			<div class="sideText">
				<pre><code class="language-html small-code">{code}</code></pre>
			</div>
		</div>
	</Slide>
	<Slide data-background-image="https://talk-assets.s3.fr-par.scw.cloud/elysium_0.jpg">
		<img src="https://talk-assets.s3.fr-par.scw.cloud/sisyphus.png" style="width: 50%" class="fragment">
	</Slide>
	<Slide data-background-image="https://talk-assets.s3.fr-par.scw.cloud/elysium_0.jpg">
		<div class="sideToSide">
			<img src="https://talk-assets.s3.fr-par.scw.cloud/sisyphus.png" style="width: 50%">
			<div class="sideText">
				<ul>
					<li class="fragment">Cache / CDN</li>
				</ul>
			</div>
		</div>
	</Slide>
	<Slide data-background-image="https://talk-assets.s3.fr-par.scw.cloud/elysium_1.jpg">
		<div class="heroContainer fragment">
			<img src="https://talk-assets.s3.fr-par.scw.cloud/hermes.png">
			<TextBox title="Hermes" subtitle="Plus radin que Charon" class="textbox">
				<p>C'est bien gentil tout ça mais je peux éviter de dépenser trop d'argent dans les nuages ?</p>
			</TextBox>
		</div>
	</Slide>
</Slide>

<style>
	h1 {
		font-family: "Spectral SC", system-ui;
		font-size: 5rem;
		background-color: #000;
		width: 100%;
		color: #40bb3f;
		margin-bottom: 40vh;
	}

	.sideToSide {
		display: flex;
		gap: 36px;
	}

	.sideText {
		flex: 1;
		background-color: black;

		ul {
			height: 100%;
			display: flex;
			flex-direction: column;
			justify-content: space-around;
		}
	}

	.heroContainer {
		display: flex;
		align-items: center;

		> img {
			width: 40%;
			margin: 0;
			transform: scale(2) translate(19%);
		}

		.textbox {
			width: 60%;
			transform: translateY(7%);
		}
	}

	.container {
		position: relative;
		container-type: inline-size;

		img {
			margin: 0;
		}
	}

	.transformer {
		position: absolute;
		top: 10cqh;
		left: 55cqw;
		background-color: black;
	}

	.cache {
		position: absolute;
		top: 45cqh;
		left: 50cqw;
		background-color: black;
	}

	.imageRaw {
		position: absolute;
		top: 35cqh;
		left: 20cqw;
		background-color: black;
	}

	.webpage {
		position: absolute;
		bottom: 7cqh;
		right: 12cqw;
		background-color: black;
	}

	.logo-display {
		display: grid;
		align-items: center;
		grid-template-columns: repeat(6, 1fr);
		gap: 20px;
		background-color: black;
	}

	.picture {
		display: grid;
		grid-template-rows: 60% 40%;
		img {
			margin: auto;
		}
		p {
			font-size: 1.5rem;
		}
	}

	.local-code {
		margin: 0;
	}

	.small-code {
		font-size: 1rem;
	}
</style>
