---
import Slide from "../components/Slide.astro";
---

<Slide data-background-color="black">
	<div class="container">
		<img src="https://talk-assets.s3.fr-par.scw.cloud/hell_map_tartarus.webp">
		<img src="https://talk-assets.s3.fr-par.scw.cloud/hades-pin.webp" class="pin">
	</div>
</Slide>

<style lang="scss">
	@keyframes slideUpToFields {
		0% {
			transform: translateY(calc(-90% + 90vh));
		}
		100% {
			transform: translateY(calc(-70% + 90vh));
		}
	}

	@keyframes clip {
		0% {
			opacity: 0;
		}
		100% {
			opacity: 1;
		}
	}

	@keyframes moveToFields {
		0% {
			transform: translate(231.4%, -543.8%);
		}
		50% {
			transform: translate(-71.6%, -1343.8%)
		}
		66% {
			transform: translate(-548.6%, -1397.8%);
		}
		90% {
			transform: translate(481.2%, -1492.8%);
		}
		100% {
			transform: translate(71.2%, -1548.8%);
		}
	}

	img {
		width: 100%;
	}

	.present {
		.container {
			animation: slideUpToFields 2s 1s ease-in-out forwards;
		}
		.pin {
			animation: moveToFields 2s 1s linear forwards, clip 0.5s 4s alternate infinite;
		}
	}

	.container {
		position: relative;
		transform: translateY(calc(-90% + 90vh));
	}

	.pin {
		position: absolute;
		bottom: 13.5%;
		left: 48%;
		width: 2.5%;
		transform: translate(231.4%, -543.8%);
	}
</style>
