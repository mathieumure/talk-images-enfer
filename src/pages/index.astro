---
import Layout from "../layouts/Layout.astro";
import Title from "../slides/Title.astro";
import Map from "../slides/Map.astro";
import SpeakerAntoineCharon from "../slides/SpeakerAntoineCharon.astro";
import SpeakerMathieuMort from "../slides/SpeakerMathieuMort.astro";
import ImageProblems from "../slides/ImageProblems.astro";
import Asphodel from "../slides/Asphodel.astro";
import Map2 from "../slides/Map2.astro";
import Tartarus from "../slides/Tartarus.astro";
import Map3 from "../slides/Map3.astro";
import FieldsOfMourning from "../slides/FieldsOfMourning.astro";
import Map4 from "../slides/Map4.astro";
import Elysium from "../slides/Elysium.astro";
import Map5 from "../slides/Map5.astro";
import Conclusion from "../slides/Conclusion.astro";
---

<Layout title="Au secours, mes images pourrissent mes perfs">
	<main class="reveal">
		<div class="slides">
			<Title />
			<SpeakerAntoineCharon />
			<SpeakerMathieuMort />
			<ImageProblems />
			<Map />
			<Asphodel />
			<Map2 />
			<Tartarus />
			<Map3 />
			<FieldsOfMourning />
			<Map4 />
			<Elysium />
			<Map5 />
			<Conclusion />
		</div>
	</main>
</Layout>
